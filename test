import React, { useEffect, useState } from "react";
import "./ResultPage.css";

const ResultsPage = () => {
  const [displayData, setDisplayData] = useState(null);

  useEffect(() => {
    if (window.opener && window.opener.data) {
      setDisplayData(window.opener.data);
    }
  }, []);

  if (!displayData) {
    return <h2>No Data Available</h2>;
  }

  return (
    <div className="results-page">
      <header className="navbar">
        <h1>OpenShiftAccelerate</h1>
      </header>

      <h2>ConfigDriftValidator - Identifies and highlights differences between environment configurations</h2>
      <h3>{displayData.environment || "Environment"}</h3>

      <table className="results-table">
        <thead>
          <tr>
            <th>Description</th>
            <th>Value</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Total number of properties found</td>
            <td>{displayData.total_keys || "N/A"}</td>
          </tr>
          <tr>
            <td>Number of Matching properties</td>
            <td>{displayData.matching || "N/A"}</td>
          </tr>
          <tr>
            <td>Number of Missing properties</td>
            <td>{displayData.missing || "N/A"}</td>
          </tr>
          <tr>
            <td>Number of Mismatching values</td>
            <td>{displayData.mismatching || "N/A"}</td>
          </tr>
        </tbody>
      </table>

      <p className="highlight-info">
        Highlighted the mismatches below. Certain properties like venafi are environment-specific and a mismatch may be expected. Others are environment-agnostic and should be reviewed to ensure consistency.
      </p>
    </div>
  );
};

export default ResultsPage;
