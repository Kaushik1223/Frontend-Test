import Select from "react-select";

<div className="input-field">
  <Select
    placeholder="Target Environment"
    name="targetEnv"
    options={filteredOptions()}
    closeMenuOnSelect={false}
    menuPortalTarget={document.body}
    required
    isDisabled={isDisabled.targetEnv}
    value={selectedOptions}
    onChange={handlemulti}
    isMulti={true}
    hideSelectedOptions={false}
    getOptionLabel={(e) => (
      <div style={{ display: "flex", alignItems: "center", gap: "8px" }}>
        <input type="checkbox" checked={selectedOptions?.some(opt => opt.value === e.value)} readOnly />
        <span>{e.label}</span>
      </div>
    )}
    formatOptionLabel={(e) => <span>{e.label}</span>} // Ensures selected display shows only text
  />
</div>;
