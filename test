.result-page {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 20px;
    font-family: Arial, sans-serif;
}

.result-title {
    font-size: 24px;
    font-weight: bold;
    margin-bottom: 20px;
    color: #333;
}

.result-table {
    width: 80%;
    border-collapse: collapse;
    margin-top: 10px;
}

.result-table th, .result-table td {
    border: 1px solid #ddd;
    padding: 10px;
    text-align: left;
}

.result-table th {
    background-color: #004080;
    color: white;
    font-weight: bold;
}

.result-table tr:nth-child(even) {
    background-color: #f2f2f2;
}

.result-table tr:hover {
    background-color: #ddd;
}

.back-button {
    margin-top: 20px;
    padding: 10px 20px;
    font-size: 16px;
    background-color: #004080;
    color: white;
    border: none;
    border-radius: 5px;
    cursor: pointer;
}

.back-button:hover {
    background-color: #002d5a;
}
