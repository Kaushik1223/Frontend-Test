import React, { useState } from "react";
import "./InputBox.css";
import axios from "axios";

const InputBox = () => {
  const [formData, setFormData] = useState({
    applicationId: "",
    componentName: "",
    githubToken: "",
    branchName: "",
    referenceEnv: "",
    targetEnv: ""
  });

  const envOptions = ["dev", "sit", "uat", "prodsl", "prodox"];

  const handleChange = (e) => {
    const { name, value } = e.target;
    setFormData({ ...formData, [name]: value });
  };

  const handleCompare = async (e) => {
    e.preventDefault();

    const url =
      "https://ca3021-driftvalidatorservice.apps.temr-clfn-n-05.cf.wellsfargo.net/apps/compareEnvs";

    const requestPayload = {
      bearer_token: formData.githubToken,
      appid: formData.applicationId,
      component: formData.componentName,
      branch: formData.branchName,
      env1: formData.referenceEnv,
      envs: [formData.targetEnv]
    };

    try {
      const response = await axios.post(url, requestPayload);

      const displayData = {
        environment: formData.targetEnv,
        total_keys: response.data.uat.total_keys,
        matching: response.data.uat.matching_keys,
        mismatching: response.data.uat.mismatching_keys,
        missing: response.data.uat.missing_keys,
        mismatching_list: response.data.uat.mismatching_keys_list,
        missing_list: response.data.uat.missing_keys_list
      };

      // Open a new tab and pass the data
      const resultTab = window.open("/results", "_blank");

      // Wait for the tab to load and set data
      setTimeout(() => {
        if (resultTab) {
          resultTab.data = displayData;
        }
      }, 1000);
    } catch (error) {
      console.error("Error fetching comparison result:", error);
    }
  };

  return (
    <div className="input-box">
      <h3>Compare Environments</h3>

      <div className="input-field">
        <label className={formData.applicationId ? "active" : ""}>
          Application Id
        </label>
        <input
          type="text"
          name="applicationId"
          value={formData.applicationId}
          onChange={handleChange}
        />
      </div>

      <div className="input-field">
        <label className={formData.componentName ? "active" : ""}>
          Component Name
        </label>
        <input
          type="text"
          name="componentName"
          value={formData.componentName}
          onChange={handleChange}
        />
      </div>

      <div className="input-field">
        <label className={formData.githubToken ? "active" : ""}>
          GitHub Personal Access Token (Write Access)
        </label>
        <input
          type="password"
          name="githubToken"
          value={formData.githubToken}
          onChange={handleChange}
        />
      </div>

      <div className="input-field">
        <label className={formData.branchName ? "active" : ""}>
          Branch Name
        </label>
        <input
          type="text"
          name="branchName"
          value={formData.branchName}
          onChange={handleChange}
        />
      </div>

      <div className="input-field">
        <select name="referenceEnv" value={formData.referenceEnv} onChange={handleChange}>
          <option value="" disabled hidden>
            Reference Environment
          </option>
          {envOptions.map((env) => (
            <option key={env} value={env}>
              {env}
            </option>
          ))}
        </select>
      </div>

      <div className="input-field">
        <select name="targetEnv" value={formData.targetEnv} onChange={handleChange}>
          <option value="" disabled hidden>
            Target Environment
          </option>
          {envOptions.map((env) => (
            <option key={env} value={env}>
              {env}
            </option>
          ))}
        </select>
      </div>

      <button className="compare-btn" onClick={handleCompare}>
        COMPARE
      </button>
    </div>
  );
};

export default InputBox;
