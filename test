function ErrorMessage({ message }) {
  if (!message) return null; // Don't show if there's no error message

  return (
    <div
      style={{
        position: "fixed",
        top: "50%",
        left: "50%",
        transform: "translate(-50%, -50%)",
        backgroundColor: "rgba(255, 0, 0, 0.9)", // Red with transparency
        color: "white",
        padding: "15px 20px",
        borderRadius: "8px",
        border: "2px solid darkred",
        fontWeight: "bold",
        textAlign: "center",
        width: "300px",
        boxShadow: "0px 0px 10px rgba(0, 0, 0, 0.5)",
        zIndex: 1000,
      }}
    >
      {message}
    </div>
  );
}

export default ErrorMessage;
