<div>
  <h1>Summary</h1>
  <table 
    className="result-table" 
    style={{ borderCollapse: "collapse", width: "60%", textAlign: "center" }}
  >
    <thead>
      <tr>
        <th style={{ padding: "10px", borderBottom: "2px solid black" }}>Environment</th>
        <th style={{ padding: "10px", borderBottom: "2px solid black" }}>Matching keys</th>
        <th style={{ padding: "10px", borderBottom: "2px solid black" }}>Mismatching keys</th>
        <th style={{ padding: "10px", borderBottom: "2px solid black" }}>Missing keys</th>
        <th style={{ padding: "10px", borderBottom: "2px solid black" }}>Total keys</th>
      </tr>
    </thead>
    <tbody>
      {table.map((t) => (
        <tr key={t.target}>
          <td style={{ padding: "10px", borderBottom: "1px solid gray" }}>{t.target}</td>
          <td style={{ padding: "10px", borderBottom: "1px solid gray" }}>{t.matching}</td>
          <td style={{ padding: "10px", borderBottom: "1px solid gray" }}>{t.mismatching}</td>
          <td style={{ padding: "10px", borderBottom: "1px solid gray" }}>{t.missing}</td>
          <td style={{ padding: "10px", borderBottom: "1px solid gray" }}>{t.total}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
