import React from 'react';
import './ResultPage.css';

const ResultPage = ({ data, onBack }) => {
    return (
        <div className="result-page">
            <h2 className="result-title">Comparison Results</h2>
            <table className="result-table">
                <thead>
                    <tr>
                        <th>Category</th>
                        <th>Keys</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>Matching Keys</td>
                        <td>{data?.matching || 'N/A'}</td>
                    </tr>
                    <tr>
                        <td>Mismatching Keys</td>
                        <td>{data?.mismatching || 'N/A'}</td>
                    </tr>
                    <tr>
                        <td>Missing Keys</td>
                        <td>{data?.missing || 'N/A'}</td>
                    </tr>
                    <tr>
                        <td>Total Keys</td>
                        <td>{data?.total_keys || 'N/A'}</td>
                    </tr>
                    <tr>
                        <td>Mismatching List</td>
                        <td>{data?.mismatchinglist?.join(', ') || 'N/A'}</td>
                    </tr>
                    <tr>
                        <td>Missing List</td>
                        <td>{data?.missing_list?.join(', ') || 'N/A'}</td>
                    </tr>
                </tbody>
            </table>
            <button className="back-button" onClick={onBack}>Back</button>
        </div>
    );
};

export default ResultPage;
