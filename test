import React, { useState } from 'react';
import InputBox from './InputBox';
import ResultPage from './ResultPage';
import Sidebar from './Sidebar'; // Your sidebar component
import InfoBox from './InfoBox'; // Your info box component

function App() {
    const [showResultPage, setShowResultPage] = useState(false);

    return (
        <div>
            {/* Hide Sidebar & InfoBox when in ResultPage */}
            {!showResultPage && <Sidebar />}
            {!showResultPage && <InfoBox />}
            
            {/* Render InputBox or ResultPage based on state */}
            {!showResultPage ? (
                <InputBox setShowResultPage={setShowResultPage} />
            ) : (
                <ResultPage onBack={() => setShowResultPage(false)} />
            )}
        </div>
    );
}

export default App;
