import React, { useState } from "react";
import Navbar from "./components/Navbar";
import Sidebar from "./components/Sidebar";
import InfoBox from "./components/InfoBox";
import InputBox from "./components/InputBox";
import ResultPage from "./components/ResultPage"; // Ensure this file exists
import "./App.css";

const App = () => {
  const [displayData, setDisplayData] = useState(null);

  const handleCompare = (data) => {
    setDisplayData(data); // Store the result data
  };

  return (
    <div className="app-container">
      <Navbar />
      <div className="content-wrapper">
        <Sidebar />
        <div className="main-content">
          <InfoBox info="Enter details to compare environments" />
          {displayData ? (
            <ResultPage data={displayData} onBack={() => setDisplayData(null)} />
          ) : (
            <InputBox onCompare={handleCompare} />
          )}
        </div>
      </div>
    </div>
  );
};

export default App;
