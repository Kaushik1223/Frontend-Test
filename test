import React, { useState } from 'react';
import Navbar from './components/Navbar';
import Sidebar from './components/Sidebar';
import InfoBox from './components/InfoBox';
import InputBox from './components/InputBox';
import './App.css';

const App = () => {
  const [selectedInfo, setSelectedInfo] = useState('');

  const handleSidebarClick = (option) => {
    setSelectedInfo(`Details for ${option}`);
  };

  const handleCompare = (data) => {
    // Store the data in sessionStorage before opening the result page
    sessionStorage.setItem("comparisonResult", JSON.stringify(data));
    window.open("/result", "_blank");
  };

  return (
    <div className="app-container">
      <Navbar />
      <div className="content-wrapper">
        <Sidebar onSelect={handleSidebarClick} />
        <div className="main-content">
          <InfoBox info={selectedInfo} />
          <div className="input-result-wrapper">
            <InputBox onCompare={handleCompare} />
          </div>
        </div>
      </div>
    </div>
  );
};

export default App;
