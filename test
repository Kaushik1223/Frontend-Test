.back-to-top {
  position: fixed;
  bottom: 20px;
  right: 20px;
  background-color: red;
  color: white;
  text-decoration: none;
  font-size: 24px;
  padding: 10px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 50px;
  height: 50px;
  z-index: 1000; /* Ensures it's always on top */
  cursor: pointer;
}
