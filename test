import React, { useEffect, useState } from 'react';

const ResultPage = () => {
    const [data, setData] = useState(null);

    useEffect(() => {
        // Retrieve the stored result from sessionStorage
        const resultData = sessionStorage.getItem("comparisonResult");
        if (resultData) {
            setData(JSON.parse(resultData));
        }
    }, []);

    if (!data) return <h2>No data available</h2>;

    return (
        <div>
            <h2>Comparison Results</h2>
            <table border="1">
                <thead>
                    <tr>
                        <th>Total Keys</th>
                        <th>Matching Keys</th>
                        <th>Mismatching Keys</th>
                        <th>Missing Keys</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>{data.total_keys}</td>
                        <td>{data.matching}</td>
                        <td>{data.mismatching}</td>
                        <td>{data.missing}</td>
                    </tr>
                </tbody>
            </table>
            <h3>Mismatching List:</h3>
            <pre>{JSON.stringify(data.mismatchinglist, null, 2)}</pre>
            <h3>Missing List:</h3>
            <pre>{JSON.stringify(data.missing_list, null, 2)}</pre>
        </div>
    );
};

export default ResultPage;
