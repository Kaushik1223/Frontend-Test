allprojects {
    buildscript {
        repositories {
            mavenCentral()
        }
        dependencies {
            classpath 'jakarta.servlet:jakarta.servlet-api:5.0.0'
        }
    }

    afterEvaluate {
        dependencies {
            implementation 'jakarta.servlet:jakarta.servlet-api:5.0.0'
        }
    }
}
