/* App Container */
.app-container {
    display: flex;
    flex-direction: column;
    height: 100vh;
  }


  
  /* Main Content */
  .content-wrapper {
    display: flex;
    margin-top: 65px; /* Navbar height */
    height: calc(100vh - 65px);
  }
  
  .main-content {
    margin-left: 250px; /* Sidebar width */
    padding: 20px;
    width: calc(100% - 250px);
    background-color: #f5f5f5;
    overflow-y: auto;
  }
  

  /* Input & Result Section */
  .input-result-wrapper {
    display: flex;
    justify-content: space-between;
    gap: 20px;
  }
  
 --------------------------------------

import React, { useState } from 'react';
import Navbar from './components/Navbar';
import Sidebar from './components/Sidebar';
import InfoBox from './components/InfoBox';
import InputBox from './components/InputBox';
import ResultBox from './components/ResultBox';
import './App.css';

const App = () => {
  const [selectedInfo, setSelectedInfo] = useState('');
  const [result, setResult] = useState('');

  const handleSidebarClick = (option) => {
    setSelectedInfo(`Details for ${option}`);
  };

  const handleSubmit = (data) => {
    setResult(`Processed data: ${data}`);
  };

  return (
    <div className="app-container">
      <Navbar />
      <div className="content-wrapper">
        <Sidebar onSelect={handleSidebarClick} />
        <div className="main-content">
          <InfoBox info={selectedInfo} />
          <div className="input-result-wrapper">
            <InputBox onSubmit={handleSubmit} />
            <ResultBox result={result} />
          </div>
        </div>
      </div>
    </div>
  );
};

export default App;
