import React from "react";
import { useLocation } from "react-router-dom";

const ResultsPage = () => {
  const location = useLocation();
  const displayData = location.state?.displayData || {
    matching: [],
    mismatching: [],
    missing: [],
    total: 0,
  };

  return (
    <div className="container">
      <div className="card">
        <h2 className="heading">Comparison Results</h2>
        <div className="card-content">
          <table className="result-table">
            <thead>
              <tr>
                <th>Category</th>
                <th>Keys</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>Matching Keys</td>
                <td>{displayData.matching.join(", ")}</td>
              </tr>
              <tr>
                <td>Mismatching Keys</td>
                <td>{displayData.mismatching.join(", ")}</td>
              </tr>
              <tr>
                <td>Missing Keys</td>
                <td>{displayData.missing.join(", ")}</td>
              </tr>
              <tr className="total-row">
                <td>Total Keys</td>
                <td>{displayData.total}</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  );
};

export default ResultsPage;

