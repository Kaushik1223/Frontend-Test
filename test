import React from 'react';

const ResultPage = ({ data }) => {
    if (!data) return <h2>No data available</h2>;

    return (
        <div>
            <h2>Comparison Results</h2>
            <table border="1">
                <thead>
                    <tr>
                        <th>Total Keys</th>
                        <th>Matching Keys</th>
                        <th>Mismatching Keys</th>
                        <th>Missing Keys</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>{data.total_keys}</td>
                        <td>{data.matching}</td>
                        <td>{data.mismatching}</td>
                        <td>{data.missing}</td>
                    </tr>
                </tbody>
            </table>

            <h3>Mismatching List</h3>
            <ul>
                {data.mismatchinglist?.map((item, index) => <li key={index}>{item}</li>)}
            </ul>

            <h3>Missing List</h3>
            <ul>
                {data.missinglist?.map((item, index) => <li key={index}>{item}</li>)}
            </ul>
        </div>
    );
};

export default ResultPage;
