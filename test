.back-to-top {
  position: fixed;
  bottom: 20px;
  right: 20px;
  background-color: red;
  color: white;
  border: none;
  border-radius: 50%;
  width: 50px;
  height: 50px;
  font-size: 24px;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
}

.scrollable-content {
  height: 80vh;
  overflow-y: auto;
  padding: 20px;
  border: 1px solid #ccc;
}
