import React, { useState, useEffect } from 'react';
import './ResultPage.css';

const ResultPage = ({ data, onBack }) => {
    const [showButton, setShowButton] = useState(false);

    let table = [];
    for (let i = 0; i < Object.keys(data).length; i++) {
        table.push({
            "target": data[i].target.toUpperCase(),
            "ref": data[0].reference.toUpperCase(),
            "component": data[0].component,
            "matching": data[i].matching,
            "mismatching": data[i].mismatching,
            "missing": data[i].missing,
            "total": data[i].total_keys,
        });
    }

    const scrollToMismatching = (targetEnv) => {
        const element = document.getElementById(`env-${targetEnv}`);
        if (element) {
            element.scrollIntoView({ behavior: 'smooth' });
        }
    };

    const scrollToTop = () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
    };

    useEffect(() => {
        const handleScroll = () => {
            setShowButton(window.scrollY > 300);
        };

        window.addEventListener('scroll', handleScroll);
        return () => window.removeEventListener('scroll', handleScroll);
    }, []);

    return (
        <div>
            <button className="back-button" onClick={onBack}>Back</button>
            <h1>Component - {table[0].component}</h1>
            <h1>Summary - {table[0].ref}</h1>

            <table className="result-table">
                <thead>
                    <tr>
                        <th>Environment</th>
                        <th>Matching keys</th>
                        <th>Mismatching keys</th>
                        <th>Missing keys</th>
                        <th>Total keys</th>
                    </tr>
                </thead>
                <tbody>
                    {table.map((t) => (
                        <tr key={t.target}>
                            <td>{t.target}</td>
                            <td>{t.matching}</td>
                            <td>
                                <button 
                                    className="mismatch-button"
                                    onClick={() => scrollToMismatching(t.target)}
                                >
                                    {t.mismatching}
                                </button>
                            </td>
                            <td>{t.missing}</td>
                            <td>{t.total}</td>
                        </tr>
                    ))}
                </tbody>
            </table>

            {data.map((d) => (
                <div key={d.target} id={`env-${d.target.toUpperCase()}`}>
                    <h1>{d.target.toUpperCase()}</h1>
                    {d.missinglist && d.missinglist.length > 0 && (
                        <>
                            <div><b>List of missing keys:</b></div>
                            <pre>{d.missinglist.map((item, index) => `${index + 1}.${item}`).join('\n')}</pre>
                        </>
                    )}
                    {d.mismatchinglist && d.mismatchinglist.length > 0 && (
                        <>
                            <div><b>Highlighted mismatches below:</b></div>
                            <div style={{ overflowX: 'auto', width: '100%' }}>
                                <pre>{d.mismatchinglist.join('\n')}</pre>
                            </div>
                        </>
                    )}
                </div>
            ))}

            {/* Back to Top Button */}
            {showButton && (
                <button className="back-to-top" onClick={scrollToTop}>
                    ⬆ Back to Top
                </button>
            )}
        </div>
    );
};

export default ResultPage;
