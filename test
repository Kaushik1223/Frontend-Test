.error-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.5); /* Semi-transparent background */
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 1000;
  opacity: 0;
  animation: fadeIn 0.5s forwards;
}

.errorbox {
  color: white;
  background-color: red;
  padding: 15px 20px;
  border-radius: 8px;
  border: 2px solid darkred;
  font-weight: bold;
  text-align: center;
  min-width: 250px;
  box-shadow: 0px 0px 10px rgba(0, 0, 0, 0.3);
  transform: scale(0.9);
  animation: popIn 0.3s ease-in-out forwards;
}

/* Fade in animation */
@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

/* Pop-in effect */
@keyframes popIn {
  from { transform: scale(0.9); }
  to { transform: scale(1); }
}
