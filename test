import React, { useEffect, useState } from "react";
import "./ResultsPage.css";

const ResultsPage = () => {
  const [displayData, setDisplayData] = useState(null);

  useEffect(() => {
    // Fetch data from window object
    if (window.opener && window.opener.data) {
      setDisplayData(window.opener.data);
    }
  }, []);

  if (!displayData) {
    return <h2>No Data Available</h2>;
  }

  return (
    <div className="results-page">
      <h2>Comparison Results</h2>

      <table className="results-table">
        <thead>
          <tr>
            <th>Total Properties</th>
            <th>Matching Properties</th>
            <th>Missing Properties</th>
            <th>Mismatching Properties</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>{displayData.total_keys || "N/A"}</td>
            <td>{displayData.matching || "N/A"}</td>
            <td>{displayData.missing || "N/A"}</td>
            <td>{displayData.mismatching || "N/A"}</td>
          </tr>
        </tbody>
      </table>

      {/* Detailed mismatched properties */}
      {displayData.mismatching_keys_list && (
        <div className="mismatch-container">
          <h3>Mismatched Properties</h3>
          <pre>{JSON.stringify(displayData.mismatching_keys_list, null, 2)}</pre>
        </div>
      )}

      {displayData.missing_keys_list && (
        <div className="missing-container">
          <h3>Missing Properties</h3>
          <pre>{JSON.stringify(displayData.missing_keys_list, null, 2)}</pre>
        </div>
      )}
    </div>
  );
};

export default ResultsPage;
