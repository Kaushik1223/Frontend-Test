import React, { useState } from 'react';
import axios from 'axios';
import './InputBox.css';

const InputBox = () => {
    const [formData, setFormData] = useState({
        applicationId: '',
        componentName: '',
        githubToken: '',
        branchName: '',
        referenceEnv: '',
        targetEnv: '',
    });

    const envOptions = ['dev', 'sit', 'uat', 'prodsl', 'prodox'];

    const handleChange = (e) => {
        const { name, value } = e.target;
        setFormData({ ...formData, [name]: value });
    };

    const handleCompare = async (e) => {
        e.preventDefault();

        const url = 'https://ca3021-driftvalidatorservice.apps.temr-clfn-n-05.cf.wellsfargo.net/apps/compareEnvs';

        const requestPayload = {
            "bearer_token": formData.githubToken,
            "appid": formData.applicationId,
            "component": formData.componentName,
            "branch": formData.branchName,
            "env1": formData.referenceEnv,
            "envs": [formData.targetEnv]
        };

        try {
            const response = await axios.post(url, requestPayload);
            console.log(response.data);

            // Store results in sessionStorage
            const resultData = {
                matching: response.data.uat.matching_keys,
                mismatching: response.data.uat.mismatching_keys,
                missing: response.data.uat.missing_keys,
                total_keys: response.data.uat.total_keys,
                mismatchinglist: response.data.uat.mismatching_keys_list,
                missing_list: response.data.uat.missing_keys_list,
            };

            sessionStorage.setItem("comparisonResult", JSON.stringify(resultData));

            // Open the result page in a new tab
            window.open("/result", "_blank");

        } catch (error) {
            if (axios.isAxiosError(error)) {
                console.error('Axios error fetching comparison result:', error.response?.data || error.message);
            } else {
                console.error('Unexpected error fetching comparison result:', error);
            }
        }
    };

    return (
        <div className="input-box">
            <h3>Compare Environments</h3>

            {/* Application ID */}
            <div className="input-field">
                <label className={formData.applicationId ? 'active' : ''}>Application ID</label>
                <input type="text" name="applicationId" value={formData.applicationId} onChange={handleChange} />
            </div>

            {/* Component Name */}
            <div className="input-field">
                <label className={formData.componentName ? 'active' : ''}>Component Name</label>
                <input type="text" name="componentName" value={formData.componentName} onChange={handleChange} />
            </div>

            {/* GitHub Token */}
            <div className="input-field">
                <label className={formData.githubToken ? 'active' : ''}>GitHub Personal Access Token (Write Access)</label>
                <input type="password" name="githubToken" value={formData.githubToken} onChange={handleChange} />
            </div>

            {/* Branch Name */}
            <div className="input-field">
                <label className={formData.branchName ? 'active' : ''}>Branch Name</label>
                <input type="text" name="branchName" value={formData.branchName} onChange={handleChange} />
            </div>

            {/* Reference Environment */}
            <div className="input-field">
                <label>Reference Environment</label>
                <select name="referenceEnv" value={formData.referenceEnv} onChange={handleChange}>
                    <option value="" disabled hidden>Select Reference Environment</option>
                    {envOptions.map((env) => (
                        <option key={env} value={env}>{env}</option>
                    ))}
                </select>
            </div>

            {/* Target Environment */}
            <div className="input-field">
                <label>Target Environment</label>
                <select name="targetEnv" value={formData.targetEnv} onChange={handleChange}>
                    <option value="" disabled hidden>Select Target Environment</option>
                    {envOptions.map((env) => (
                        <option key={env} value={env}>{env}</option>
                    ))}
                </select>
            </div>

            {/* Submit Button */}
            <button className="compare-btn" onClick={handleCompare}>COMPARE</button>
        </div>
    );
};

export default InputBox;
