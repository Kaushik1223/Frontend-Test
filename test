import React, { useState, useEffect } from "react";
import "./ResultPage.css"; // Add styling as needed

const ResultsPage = () => {
  const [displayData, setDisplayData] = useState(null);

  useEffect(() => {
    // Retrieve data passed from InputBox
    const receivedData = window.data;
    if (receivedData) {
      setDisplayData(receivedData);
    }
  }, []);

  if (!displayData) {
    return <h2>No data available</h2>;
  }

  return (
    <div className="results-container">
      <h2>ConfigDriftValidator - Identifies and Highlights Differences</h2>
      <h3>{displayData.environment.toUpperCase()}</h3>

      <table className="results-table">
        <thead>
          <tr>
            <th>Description</th>
            <th>Value</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Total number of properties found</td>
            <td>{displayData.total_keys}</td>
          </tr>
          <tr>
            <td>Number of Matching properties</td>
            <td>{displayData.matching}</td>
          </tr>
          <tr>
            <td>Number of Missing properties</td>
            <td>{displayData.missing}</td>
          </tr>
          <tr>
            <td>Number of Mismatching values</td>
            <td>{displayData.mismatching}</td>
          </tr>
        </tbody>
      </table>

      <h3>Mismatching List</h3>
      <ul>
        {displayData.mismatching_list.map((item, index) => (
          <li key={index}>{item}</li>
        ))}
      </ul>

      <h3>Missing List</h3>
      <ul>
        {displayData.missing_list.map((item, index) => (
          <li key={index}>{item}</li>
        ))}
      </ul>
    </div>
  );
};

export default ResultsPage;
