const convertToIST = (usTime) => {
  // Combine the date and time for accurate conversion
  const usDateTime = `${table[0].dateTime[0]} ${usTime}`;

  // Create a Date object assuming the backend sends US time in UTC
  const dateObj = new Date(usDateTime + " UTC");

  // Convert to IST (Indian Standard Time)
  return dateObj.toLocaleString("en-IN", { timeZone: "Asia/Kolkata" });
};
