.input-box {
    background-color: #fff;
    padding: 20px;
    border-radius: 8px;
    box-shadow: 0 0 10px rgba(0,0,0,0.1);
    width: 600px; /* Increased width */
    max-width: 90%; /* Responsive for smaller screens */
    margin: 20px auto; /* Center horizontally */
    overflow: hidden; /* Prevent scroll */
}

.input-box h3 {
    margin-bottom: 20px;
    font-size: 22px;
    color: #333;
    text-align: center;
}

.input-field {
    position: relative;
    margin-bottom: 20px;
}

.input-field label {
    position: absolute;
    top: 50%; /* Center vertically */
    left: 12px;
    transform: translateY(-50%); /* Adjust for exact center */
    color: #999;
    pointer-events: none;
    transition: all 0.2s ease;
}


.input-field input,
.input-field select {
    width: 100%;
    padding: 12px;
    border: 1px solid #ccc;
    border-radius: 4px;
    outline: none;
    font-size: 14px;
    box-sizing: border-box;
}

.input-field input:focus,
.input-field select:focus {
    border-color: #d52228;
}

.input-field input:focus + label,
.input-field select:focus + label,
.input-field label.active {
    top: -10px;
    left: 8px;
    font-size: 12px;
    color: #d52228;
    background-color: #fff;
    padding: 0 4px;
}

.compare-btn {
    width: 100%;
    padding: 12px;
    background-color: #d52228;
    color: #fff;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    font-size: 16px;
}

.compare-btn:hover {
    background-color: #b81e23;
}

/* Prevent page scrolling */
body {
    overflow: hidden;
}

/* Grey placeholder text */
select.placeholder {
    color: #999;
  }
  
  /* Dropdown options in black */
  select option {
    color: black;
  }
  
  /* Selected value in black after choosing an option */
  select:not(.placeholder) {
    color: black;
  }

  /* Multi-select dropdown styling */
select[multiple] {
    height: auto;
    min-height: 100px;
    overflow-y: auto;
  }
