import React, { useState } from 'react';
import './InputBox.css';

const InputBox = () => {
  const [formData, setFormData] = useState({
    applicationId: '',
    componentName: '',
    githubToken: '',
    branchName: '',
    referenceEnv: '',
    targetEnv: ''
  });

  const envOptions = ['dev', 'sit', 'uat', 'prodsl', 'prodox'];

  const handleChange = (e) => {
    const { name, value } = e.target;
    setFormData({ ...formData, [name]: value });
  };

  return (
    <div className="input-box">
      <h3>Compare Environments</h3>

      {/* Application ID */}
      <div className="input-field">
        <label className={formData.applicationId ? 'active' : ''}>Application Id</label>
        <input
          type="text"
          name="applicationId"
          value={formData.applicationId}
          onChange={handleChange}
        />
      </div>

      {/* Component Name */}
      <div className="input-field">
        <label className={formData.componentName ? 'active' : ''}>Component Name</label>
        <input
          type="text"
          name="componentName"
          value={formData.componentName}
          onChange={handleChange}
        />
      </div>

      {/* GitHub Token */}
      <div className="input-field">
        <label className={formData.githubToken ? 'active' : ''}>
          GitHub Personal Access Token (Write Access)
        </label>
        <input
          type="password"
          name="githubToken"
          value={formData.githubToken}
          onChange={handleChange}
        />
      </div>

      {/* Branch Name */}
      <div className="input-field">
        <label className={formData.branchName ? 'active' : ''}>Branch Name</label>
        <input
          type="text"
          name="branchName"
          value={formData.branchName}
          onChange={handleChange}
        />
      </div>

      {/* Reference Environment */}
<div className="input-field">
  <select
    name="referenceEnv"
    value={formData.referenceEnv}
    onChange={handleChange}
    className={!formData.referenceEnv ? 'placeholder' : ''}
  >
    <option value="" disabled hidden>Reference Environment</option>
    {envOptions.map((env) => (
      <option key={env} value={env}>{env}</option>
    ))}
  </select>
</div>

{/* Target Environment */}
<div className="input-field">
  <select
    name="targetEnv"
    value={formData.targetEnv}
    onChange={handleChange}
    className={!formData.targetEnv ? 'placeholder' : ''}
  >
    <option value="" disabled hidden>Target Environment</option>
    {envOptions.map((env) => (
      <option key={env} value={env}>{env}</option>
    ))}
  </select>
</div>




      {/* Submit Button */}
      <button className="compare-btn">COMPARE</button>
    </div>
  );
};

export default InputBox;
