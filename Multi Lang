import React, { useState } from 'react';

const CompareEnvironmentsModal = ({ isOpen, onClose, onCompare }) => {
  const [formData, setFormData] = useState({
    applicationId: '',
    componentName: '',
    githubToken: '',
    branchName: '',
    referenceEnv: '',
    targetEnv: '',
  });

  const handleChange = (e) => {
    const { name, value } = e.target;
    setFormData({ ...formData, [name]: value });
  };

  const handleSubmit = (e) => {
    e.preventDefault();
    onCompare(formData);
  };

  if (!isOpen) return null;

  return (
    <div className="modal-overlay">
      <div className="modal-content">
        <h2>Compare Environments</h2>
        <form onSubmit={handleSubmit}>
          <input
            type="text"
            name="applicationId"
            placeholder="Application Id"
            value={formData.applicationId}
            onChange={handleChange}
            required
          />
          <input
            type="text"
            name="componentName"
            placeholder="Component Name"
            value={formData.componentName}
            onChange={handleChange}
            required
          />
          <input
            type="password"
            name="githubToken"
            placeholder="GitHub Personal Access Token (Write Access)"
            value={formData.githubToken}
            onChange={handleChange}
            required
          />
          <input
            type="text"
            name="branchName"
            placeholder="Branch Name"
            value={formData.branchName}
            onChange={handleChange}
            required
          />

          {/* Reference Environment Dropdown */}
          <select
            name="referenceEnv"
            value={formData.referenceEnv}
            onChange={handleChange}
            required
          >
            <option value="" disabled>
              Reference Environment
            </option>
            <option value="">dev</option>
            <option value="dev">sit</option>
            <option value="qa">uat</option>
            <option value="prod">prodsl</option>
            <option value="prod">prodox</option>
          </select>

          {/* Target Environment Dropdown */}
          <select
            name="targetEnv"
            value={formData.targetEnv}
            onChange={handleChange}
            required
          >
            <option value="" disabled>
              Target Environment
            </option>
            <option value="dev">dev</option>
            <option value="sit">sit</option>
            <option value="qa">uat</option>
            <option value="prodsl">prodsl</option>
            <option value="prodox">prodox</option>
          </select>

          <div className="modal-buttons">
            <button type="submit" className="compare-btn">
              Compare
            </button>
            <button type="button" className="cancel-btn" onClick={onClose}>
              Cancel
            </button>
          </div>
        </form>
      </div>
    </div>
  );
};

export default CompareEnvironmentsModal;
